# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL. After setting this, run: npm run prisma:deploy && npm run seed
# Local trust example: postgresql://postgres@127.0.0.1:5432/tusion?schema=public
# Remote: postgresql://USER:PASSWORD@HOST:5432/tusion?sslmode=require
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/tusion?schema=public

# Auth (use a long random JWT_SECRET in production — never commit real secrets)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_MAX=30
OTP_RATE_LIMIT_MAX=10

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Application type: Web. Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=

# Vercel Cron auth (set the same value in Vercel project env)
# Vercel automatically sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change_this_to_a_long_random_cron_secret

# Seed admin (used only by `npm run seed`)
ADMIN_NAME=Workspace Owner
ADMIN_EMAIL=admin@user.local
ADMIN_PASSWORD=change_this_password
ADMIN_IS_SUPER=true

# Razorpay (SaaS subscription billing). Leave empty to skip this gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree PG (SaaS subscription billing). Leave empty to skip this gateway.
# Dashboard → Developers → API Keys. Use sandbox keys with CASHFREE_ENV=sandbox.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# If both Razorpay and Cashfree are empty, billing uses simulated (dev) checkout.

# WhatsApp (Meta Cloud API) — overdue fee reminders / workflow notify
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS OTP (Twilio) — phone login + parent codes
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMTP email (Nodemailer) - e.g. Gmail app password or Outlook SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=User
EMAIL_ENABLED=false

# AI progress analysis - Google Gemini free-tier API key
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=false

# Cron schedules (standard cron syntax, server timezone)
PAYMENT_REMINDER_CRON=0 8 * * *
ATTENDANCE_AUTOMARK_CRON=0 20 * * *
TASK_AUTOMATION_CRON=0 6 * * *

# Fee due day of month (1-28) used when auto-generating monthly payment records
FEE_DUE_DAY=5
# Days after due date before a pending payment is considered overdue
OVERDUE_GRACE_DAYS=2
# Minimum days between repeated overdue reminder emails for the same payment
REMINDER_COOLDOWN_DAYS=3

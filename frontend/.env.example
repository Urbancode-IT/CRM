# Local: http://localhost:5000/api
# Production on Vercel: use /api (rewritten in vercel.json to the Linode API)
# Or a real HTTPS API host once DNS exists: https://api.tusion.urbancode.in/api
VITE_API_URL=http://localhost:5000/api

# Same OAuth Web client ID as backend GOOGLE_CLIENT_ID
# Add Vercel origin + Linode API origin in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=
